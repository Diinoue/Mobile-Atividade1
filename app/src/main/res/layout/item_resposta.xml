<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="10dp">

    <ImageView
        android:id="@+id/itemBandeira"
        android:layout_width="60dp"
        android:layout_height="40dp"
        android:contentDescription="@string/descricao_bandeira"
        android:scaleType="fitXY"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/itemPais"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:textSize="17sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toStartOf="@id/itemStatus"
        app:layout_constraintStart_toEndOf="@id/itemBandeira"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/itemResposta"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textColor="@color/cinza_texto"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="@id/itemPais"
        app:layout_constraintStart_toStartOf="@id/itemPais"
        app:layout_constraintTop_toBottomOf="@id/itemPais" />

    <TextView
        android:id="@+id/itemStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
